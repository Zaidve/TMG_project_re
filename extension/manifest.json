{
  "manifest_version": 3,
  "name": "Clickbait Detector (Tiếng Việt)",
  "version": "1.1.0",
  "description": "Marks clickbait headlines on Vietnamese news sites, using a local PhoBERT model service.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vnexpress.net/*",
        "https://*.vnexpress.net/*",
        "https://tuoitre.vn/*",
        "https://*.tuoitre.vn/*",
        "https://thanhnien.vn/*",
        "https://*.thanhnien.vn/*",
        "https://vietnamnet.vn/*",
        "https://*.vietnamnet.vn/*",
        "https://24h.com.vn/*",
        "https://*.24h.com.vn/*",
        "https://kenh14.vn/*",
        "https://*.kenh14.vn/*",
        "https://saostar.vn/*",
        "https://*.saostar.vn/*",
        "https://baomoi.com/*",
        "https://*.baomoi.com/*",
        "https://dantri.com.vn/*",
        "https://*.dantri.com.vn/*",
        "https://znews.vn/*",
        "https://*.znews.vn/*",
        "https://nld.com.vn/*",
        "https://*.nld.com.vn/*",
        "https://tienphong.vn/*",
        "https://*.tienphong.vn/*",
        "https://vtv.vn/*",
        "https://*.vtv.vn/*",
        "https://nhandan.vn/*",
        "https://*.nhandan.vn/*",
        "https://qdnd.vn/*",
        "https://*.qdnd.vn/*",
        "https://cand.com.vn/*",
        "https://*.cand.com.vn/*",
        "https://sggp.org.vn/*",
        "https://*.sggp.org.vn/*",
        "https://plo.vn/*",
        "https://*.plo.vn/*",
        "https://cafef.vn/*",
        "https://*.cafef.vn/*",
        "https://cafebiz.vn/*",
        "https://*.cafebiz.vn/*",
        "https://vietnamplus.vn/*",
        "https://*.vietnamplus.vn/*",
        "https://baotintuc.vn/*",
        "https://*.baotintuc.vn/*",
        "https://soha.vn/*",
        "https://*.soha.vn/*",
        "https://afamily.vn/*",
        "https://*.afamily.vn/*",
        "https://eva.vn/*",
        "https://*.eva.vn/*",
        "https://2sao.vn/*",
        "https://*.2sao.vn/*",
        "https://suckhoedoisong.vn/*",
        "https://*.suckhoedoisong.vn/*",
        "https://kienthuc.net.vn/*",
        "https://*.kienthuc.net.vn/*",
        "https://nguoiduatin.vn/*",
        "https://*.nguoiduatin.vn/*",
        "https://doisongphapluat.com.vn/*",
        "https://*.doisongphapluat.com.vn/*",
        "https://genk.vn/*",
        "https://*.genk.vn/*",
        "https://baogiaothong.vn/*",
        "https://*.baogiaothong.vn/*",
        "https://congthuong.vn/*",
        "https://*.congthuong.vn/*",
        "https://thethaovanhoa.vn/*",
        "https://*.thethaovanhoa.vn/*",
        "https://bongda.com.vn/*",
        "https://*.bongda.com.vn/*",
        "https://phunuonline.com.vn/*",
        "https://*.phunuonline.com.vn/*",
        "https://giaoducthoidai.vn/*",
        "https://*.giaoducthoidai.vn/*",
        "https://vneconomy.vn/*",
        "https://*.vneconomy.vn/*",
        "https://baophapluat.vn/*",
        "https://*.baophapluat.vn/*",
        "https://kinhtedothi.vn/*",
        "https://*.kinhtedothi.vn/*",
        "https://hanoimoi.vn/*",
        "https://*.hanoimoi.vn/*",
        "https://vietnamfinance.vn/*",
        "https://*.vietnamfinance.vn/*",
        "https://danviet.vn/*",
        "https://*.danviet.vn/*",
        "https://baoquocte.vn/*",
        "https://*.baoquocte.vn/*",
        "https://baodautu.vn/*",
        "https://*.baodautu.vn/*",
        "https://vietq.vn/*",
        "https://*.vietq.vn/*",
        "https://vtcnews.vn/*",
        "https://*.vtcnews.vn/*",
        "https://baochinhphu.vn/*",
        "https://*.baochinhphu.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Clickbait Detector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
